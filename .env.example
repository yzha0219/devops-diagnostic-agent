# Optional: configure these to enable mode="llm".
# The API must expose an OpenAI-compatible Chat Completions endpoint.
LLM_API_KEY=your_api_key_here
# Example for an OpenAI-compatible provider: https://provider.example/v1
LLM_BASE_URL=https://api.example.com/v1
# Pick a model available from your provider.
LLM_MODEL=your-model-name
