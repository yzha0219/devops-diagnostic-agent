pipeline {
    agent {
        label 'python && pr'
    }

    options {
        timestamps()
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 15, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'PR_NUMBER',
            defaultValue: '',
            description: 'GitHub Pull Request number'
        )
    }

    environment {
        REPO_URL = 'https://github.com/yzha0219/devops-diagnostic-agent.git'
    }

    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    if (!(params.PR_NUMBER ==~ /^[1-9][0-9]*$/)) {
                        error('PR_NUMBER must be a positive integer')
                    }
                }

                echo "Validating Pull Request #${params.PR_NUMBER}"
            }
        }

        stage('Checkout Pull Request') {
            steps {
                dir('pr-source') {
                    deleteDir()

                    checkout([
                        $class: 'GitSCM',
                        branches: [[
                            name: "refs/remotes/origin/pr/${params.PR_NUMBER}"
                        ]],
                        userRemoteConfigs: [[
                            url: env.REPO_URL,
                            credentialsId: 'github-readonly',
                            refspec: '+refs/pull/*/head:refs/remotes/origin/pr/*'
                        ]]
                    ])
                }
            }
        }
        stage('Capture PR Commit SHA') {
            steps {
                dir('pr-source') {
                    script {
                        env.TESTED_COMMIT_SHA = sh(
                            script: 'git rev-parse HEAD',
                            returnStdout: true
                        ).trim()
                    }

                    echo "PR Number: ${params.PR_NUMBER}"
                    echo "Tested Commit SHA: ${env.TESTED_COMMIT_SHA}"
                }
            }
        }
        stage('Publish Pending Status') {
            steps {
                build job: 'github-commit-status-writer',
                    parameters: [
                        string(
                            name: 'COMMIT_SHA',
                            value: env.TESTED_COMMIT_SHA
                        ),
                        string(
                            name: 'STATUS_STATE',
                            value: 'pending'
                        ),
                        string(
                            name: 'STATUS_DESCRIPTION',
                            value: 'PR validation started'
                        ),
                        string(
                            name: 'PR_NUMBER',
                            value: params.PR_NUMBER
                        )
                    ],
                    wait: true,
                    propagate: true
            }
        }
        stage('Install Dependencies') {
            steps {
                dir('pr-source') {
                    sh '''
                        set -eu

                        echo "===== Python Version ====="
                        python --version

                        echo "===== uv Version ====="
                        uv --version

                        python -m venv .ci-venv

                        uv pip install \
                            --python .ci-venv/bin/python \
                            -r requirements.txt
                    '''
                }
            }
        }

        stage('Run Pytest') {
            steps {
                dir('pr-source') {
                    sh '''
                        set -eu

                        .ci-venv/bin/python -m pytest -q \
                            --junitxml=pytest-results.xml
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'pr-source/pytest-results.xml',
                allowEmptyArchive: true
            )
        }

        success {
            echo "PR Validation PASSED"
        }

        failure {
            echo "PR Validation FAILED"
        }
    }
}
